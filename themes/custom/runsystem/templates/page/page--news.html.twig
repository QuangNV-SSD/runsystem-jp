<script>
  document.addEventListener("DOMContentLoaded", function () {
    // すべてのニュースタイトル要素を取得
    const newsTitles = document.querySelectorAll('.news_title[data-designpart-id="66d7ee25b2ee923e22112448"]');

    // 初期状態としてすべてのコンテンツを非表示にする
    newsTitles.forEach((title) => {
      const initialContent = title.nextElementSibling;
      if (initialContent && initialContent.classList.contains("news_content")) {
        initialContent.style.display = "none";
        // 初期状態ではopacityもリセットしておく
        initialContent.style.opacity = "";
      }
    });

    const duration = 300; // アニメーション時間 (ms)

    newsTitles.forEach((title) => {
      // クリックされたらトグル処理を行う
      title.addEventListener("click", function (event) {
        event.preventDefault();

        // クリックされたタイトルと隣接するコンテンツを取得
        const clickedTitle = this;
        const content = clickedTitle.nextElementSibling;
        if (!content || !content.classList.contains("news_content")) {
          return;
        }

        // 連続クリックによるアニメーションのキューイングを防ぐ (stop(false, true)に相当)
        const stopCurrentAnimation = (el) => {
          const currentAnimation = el.getAnimations().find((anim) => anim.effect instanceof KeyframeEffect);
          if (currentAnimation) {
            currentAnimation.cancel();
          }
        };

        // ---------------------------------------------
        // 1. 他の開いているコンテンツを閉じる（フェードアウト）
        // ---------------------------------------------
        newsTitles.forEach((otherTitle) => {
          if (otherTitle !== clickedTitle && otherTitle.classList.contains("is-active")) {
            const otherContent = otherTitle.nextElementSibling;
            if (otherContent) {
              // 他のコンテンツのアニメーションを停止し、即座に逆方向へ
              stopCurrentAnimation(otherContent);

              // クラスを解除
              otherTitle.classList.remove("is-active");

              // 閉じるアニメーション
              const closeAnimation = otherContent.animate(
                {
                  height: [otherContent.offsetHeight + "px", "0px"],
                  opacity: [1, 0], // ⭐ フェードアウト
                  paddingTop: [window.getComputedStyle(otherContent).paddingTop, "0px"],
                  paddingBottom: [window.getComputedStyle(otherContent).paddingBottom, "0px"],
                },
                {duration: duration, easing: "ease-out"}
              );

              closeAnimation.onfinish = () => {
                // 終了時に表示を完全に非表示に設定
                otherContent.style.display = "none";
                otherContent.style.height = "";
                otherContent.style.opacity = "";
                otherContent.style.paddingTop = "";
                otherContent.style.paddingBottom = "";
              };
            }
          }
        });

        // ---------------------------------------------
        // 2. クリックされたコンテンツのトグル処理
        // ---------------------------------------------
        stopCurrentAnimation(content);

        if (clickedTitle.classList.contains("is-active")) {
          // --- 閉じる (フェードアウト) ---
          clickedTitle.classList.remove("is-active");

          const closeAnimation = content.animate(
            {
              height: [content.offsetHeight + "px", "0px"],
              opacity: [1, 0], // ⭐ フェードアウト
              paddingTop: [window.getComputedStyle(content).paddingTop, "0px"],
              paddingBottom: [window.getComputedStyle(content).paddingBottom, "0px"],
            },
            {duration: duration, easing: "ease-out"}
          );

          closeAnimation.onfinish = () => {
            content.style.display = "none";
            content.style.height = "";
            content.style.opacity = "";
            content.style.paddingTop = "";
            content.style.paddingBottom = "";
          };
        } else {
          // --- 開く (フェードイン) ---
          clickedTitle.classList.add("is-active");

          // 開く時の最終的な高さを計算
          content.style.display = "flex";
          content.style.height = "auto";
          const finalHeight = content.offsetHeight + "px";
          content.style.height = "0px"; // アニメーション開始準備

          const openAnimation = content.animate(
            {
              height: ["0px", finalHeight],
              opacity: [0, 1], // ⭐ フェードイン
              paddingTop: ["0px", window.getComputedStyle(content).paddingTop],
              paddingBottom: ["0px", window.getComputedStyle(content).paddingBottom],
            },
            {duration: duration, easing: "ease-in-out"}
          );

          openAnimation.onfinish = () => {
            content.style.height = "";
            content.style.opacity = "";
            content.style.paddingTop = "";
            content.style.paddingBottom = "";
          };
        }
      });
    });
  });
</script>

